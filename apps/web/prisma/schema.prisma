generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("growth")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  retailers Retailer[]
  users     User[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  role          String    @default("member")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Retailer {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  code              String
  disputeWindowDays Int      @default(30)
  color             String?
  createdAt         DateTime @default(now())

  deductions Deduction[]

  @@unique([tenantId, code])
}

model Deduction {
  id                String   @id @default(cuid())
  tenantId          String
  retailerId        String
  retailer          Retailer @relation(fields: [retailerId], references: [id])
  externalId        String
  amount            Float
  reasonCode        String
  reasonDescription String?
  status            String   @default("NEW")
  faultParty        String   @default("UNKNOWN")
  evidenceScore     Int      @default(0)
  deductionDate     DateTime
  deadlineDate      DateTime
  invoiceNumber     String?
  poNumber          String?
  shipmentId        String?
  rawPayload        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, deadlineDate])
  @@unique([tenantId, retailerId, externalId])
}

model Shipment {
  id                  String    @id @default(cuid())
  tenantId            String
  proNumber           String?
  bolNumber           String?
  carrierName         String?
  thirdPartyLogistics String?
  podUrl              String?
  podSigned           Boolean   @default(false)
  deliveryDate        DateTime?
  appointmentTime     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deductions Deduction[]

  @@index([tenantId, proNumber])
}

model Dispute {
  id               String   @id @default(cuid())
  tenantId         String
  deductionId      String   @unique
  status           String   @default("DRAFT")
  requestedAmount  Float
  submissionMethod String?
  confirmationNumber String?
  letterHtml       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EvidenceRecord {
  id           String   @id @default(cuid())
  tenantId     String
  deductionId  String
  evidenceType String
  sourceSystem String?
  documentUrl  String?
  confidence   Float?
  createdAt    DateTime @default(now())

  @@index([tenantId, deductionId])
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  netsuiteId    String
  invoiceNumber String
  poNumber      String?
  customerName  String?
  totalAmount   Float
  invoiceDate   DateTime
  status        String   @default("SYNCED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, netsuiteId])
  @@index([tenantId, invoiceNumber])
}
